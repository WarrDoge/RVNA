DATABASE_URL=postgres://rvna:rvna@127.0.0.1:55440/rvna
PORT=3000
APP_URL=http://localhost:3000
# Public origin SvelteKit trusts; set this behind a reverse proxy.
ORIGIN=http://localhost:3000
# adapter-node request limit. 0 means zero bytes; Infinity lets the app caps decide.
BODY_SIZE_LIMIT=250M
MAX_UPLOAD_REQUEST_MB=250
# Largest single attachment; must not exceed MAX_UPLOAD_REQUEST_MB.
MAX_ATTACHMENT_MB=100
# Single sign-on is optional: leave the three OIDC values empty to use local accounts only,
# otherwise set all three.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_GROUPS_CLAIM=groups
ADMIN_GROUP=rvna-admins
SESSION_TTL_DAYS=14
# Time zone for dates when the browser sends none (a first request, a script): an IANA name
APP_TIME_ZONE=UTC
DEV_LOGIN_USER=
# true sends /login.jsp straight to SSO; /login.jsp?local=1 still shows the local form
SSO_AUTO_REDIRECT=false
# First administrator, created at startup only while no administrator exists, and forced to change
# the password at the first login. Set both, or use "npm run user:create" instead. Do not commit them.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Behind a proxy that overwrites X-Forwarded-*, adapter-node reads the client address and the public
# origin from these (uncomment all four; XFF_DEPTH is the number of trusted proxies):
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
JIRA_URL=
JIRA_PAT=
ATTACHMENTS_DIR=./data/attachments
AVATARS_DIR=./data/avatars
SMTP_URL=
MAIL_FROM=rvna <rvna@localhost>
# Send every message to this address instead, for a non-production instance with real data.
MAIL_REDIRECT_TO=
SECRETS_KEY=
# adapter-node waits this many seconds for in-flight requests after SIGTERM (default 30).
# SHUTDOWN_TIMEOUT=110
CONFLUENCE_URL=
CONFLUENCE_PAT=
# Version shown on the System info page
APP_VERSION=
